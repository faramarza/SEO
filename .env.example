# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# ── Tool login (Governor) ──────────────────────────────────────────────
# Username is fixed to AlphabetAdmin unless you override it here.
GOVERNOR_USERNAME=AlphabetAdmin
# REQUIRED to enable the login gate. If unset, the tool runs OPEN (no auth).
GOVERNOR_PASSWORD=
# Optional: a fixed session secret so logins survive restarts/redeploys.
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
GOVERNOR_SECRET_KEY=

# ── Existing integrations (examples; set the ones you use) ─────────────
# ANTHROPIC_API_KEY=
# SERP_AUTO_COLLECT=false
# AUTO_EVAL=1
# AUTO_EVAL_INTERVAL_HOURS=48

# ── SEO Loop (unattended meta experiments — /loop) ─────────────────────
# Magento REST access for the loop's meta writes. Create an Integration
# (Admin → System → Integrations) with a role scoped to CATALOG ONLY and
# paste its Access Token here — never an admin login token.
MAGENTO_BASE_URL=https://alphabet-trains.com
MAGENTO_TOKEN=
# Optional: your store view code (Admin → Stores → All Stores). If unset,
# the loop auto-detects and falls back through valid scopes on its own.
# MAGENTO_STORE_CODE=default

# Loop caps and windows. These ARE the defaults — uncomment to tweak.
# Lowering caps is always safe; raising them muddies experiment
# attribution; verify below ~21 days reverts changes Google hasn't
# finished processing.
# SEO_LOOP_WRITES_PER_DAY=1
# SEO_LOOP_WRITES_PER_WEEK=5
# SEO_LOOP_MIN_IMPRESSIONS=200
# SEO_LOOP_VERIFY_DAYS=28

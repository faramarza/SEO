# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# ── Tool login (Governor) ──────────────────────────────────────────────
# Username is fixed to AlphabetAdmin unless you override it here.
GOVERNOR_USERNAME=AlphabetAdmin
# REQUIRED to enable the login gate. If unset, the tool runs OPEN (no auth).
GOVERNOR_PASSWORD=
# Optional: a fixed session secret so logins survive restarts/redeploys.
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
GOVERNOR_SECRET_KEY=

# ── Existing integrations (examples; set the ones you use) ─────────────
# ANTHROPIC_API_KEY=
# SERP_AUTO_COLLECT=false
# AUTO_EVAL=1
# AUTO_EVAL_INTERVAL_HOURS=48
